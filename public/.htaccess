<IfModule mod_rewrite.c>
    RewriteEngine On

    # تنظیمات مربوط به MultiViews و Indexes
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # تنظیمات CORS
    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "https://mandegarpars.com"
        Header always set Access-Control-Allow-Credentials "true"
        Header always set Access-Control-Allow-Headers "Authorization, Accept, Content-Type, Origin"
        Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    </IfModule>

    # پاسخ به درخواست‌های OPTIONS با کد 200
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # مدیریت هدر Authorization
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # هدایت اسلش انتهایی اگر دایرکتوری نباشد
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ارسال درخواست‌ها به کنترلر اصلی اگر فایل یا دایرکتوری وجود ندارد
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
